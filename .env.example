# ============================================================
# BORING FACTS POKÉMON VIDEO GENERATOR - ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env

# ============================================================
# REQUIRED API KEYS
# ============================================================

# Groq API (REQUIRED - for script generation)
# Get free API key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ElevenLabs API (REQUIRED - for voiceover)
# Get API key: https://elevenlabs.io/app/speech-synthesis
# Free tier: 10,000 characters/month
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ============================================================
# OPTIONAL API KEYS
# ============================================================

# OpenAI API (OPTIONAL - alternative for voiceover)
# Get API key: https://platform.openai.com/api-keys
# If ElevenLabs fails, OpenAI TTS will be used
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# SERVER CONFIGURATION
# ============================================================

# Server port (default: 3000)
PORT=3000

# ============================================================
# NOTES
# ============================================================
# Images: Uses Pollinations.ai (100% FREE, no API key needed)
# Videos: Uses FFmpeg (must be installed on your system)
